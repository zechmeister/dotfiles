#!/usr/bin/env bash
# gh-open: Open current git repository in the default browser (GitHub, GitLab, etc.)

set -euo pipefail

target_dir="${1:-$PWD}"
cd "$target_dir"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: Not a git repository ($target_dir)" >&2
    exit 1
fi

url=$(git remote get-url origin 2>/dev/null || true)

if [[ -z "$url" ]]; then
    echo "Error: No 'origin' remote found for this repository." >&2
    exit 1
fi

# Normalize SSH and HTTPS URLs to https web URL
if [[ "$url" == git@* ]]; then
    url="${url#git@}"
    url="${url/:/\/}"
    url="https://$url"
elif [[ "$url" == ssh://git@* ]]; then
    url="${url#ssh://git@}"
    url="https://$url"
fi

# Strip trailing .git suffix
url="${url%.git}"

echo "Opening $url..."
if command -v open >/dev/null 2>&1; then
    open "$url"
elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url"
else
    echo "$url"
fi
