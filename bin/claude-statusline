#!/bin/bash
input=$(cat)

MODEL=$(jq -r '.model.display_name // "?" | sub(" *\\(.*\\)$"; "") | gsub(" "; "")' <<<"$input")
PCT=$(jq -r '.context_window.used_percentage // 0 | floor' <<<"$input")
USED_K=$(jq -r '(.context_window.total_input_tokens // 0) / 1000 | floor' <<<"$input")
MAX_K=$(jq -r '.context_window.context_window_size / 1000 | floor' <<<"$input")

printf '%dk/%dk/\033[1m%d%%\033[0m %s\n' "$USED_K" "$MAX_K" "$PCT" "$MODEL"
